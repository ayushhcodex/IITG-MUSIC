services:
  - type: web
    name: cosmic-raga
    env: python
    buildCommand: "pip install -r requirements.txt"
    startCommand: "uvicorn backend_app:app --host 0.0.0.0 --port $PORT"
    envVars:
      - key: PYTHON_VERSION
        value: 3.10
preDeployCommand: "apt-get update && apt-get install -y fluidsynth"
